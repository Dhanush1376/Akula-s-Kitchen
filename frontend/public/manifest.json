{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "/",
  "name": "Akula's Kitchen",
  "short_name": "Akula's Kitchen",
  "description": "Authentic flavors, premium quality, and exquisite culinary experiences by Akula's Kitchen.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "background_color": "#ffffff",
  "theme_color": "#F7BB0E",
  "orientation": "any",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["shopping", "food"],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+akula",
      "url": "/?open_app=true&target=%s"
    }
  ],
  "icons": [
    {
      "src": "/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop Menu",
      "short_name": "Menu",
      "description": "Browse our handcrafted culinary collections and specialties",
      "url": "/collections",
      "icons": [
        {
          "src": "/pwa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Track Orders",
      "short_name": "Orders",
      "description": "View live order status and delivery updates",
      "url": "/dashboard/orders",
      "icons": [
        {
          "src": "/pwa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Wishlist",
      "short_name": "Wishlist",
      "description": "View your saved favorites and saved dishes",
      "url": "/wishlist",
      "icons": [
        {
          "src": "/pwa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
